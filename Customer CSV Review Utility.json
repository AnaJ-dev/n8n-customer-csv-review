      "parameters": {
        "jsCode": "const items = $input.all();\nconst itemCount = items.length;\nconst averageAge =\n  items.reduce((sum, item) => sum + Number(item?.json?.age), 0) / itemCount;\nconst emails = items.map((item) => item?.json?.email);\n\nreturn [{ json: { itemCount, averageAge, emails } }];\n"
      },
