      "parameters": {
        "jsCode": "const getAll=$input.all()\nlet reviewRequired\nconst avgAge=getAll[0].json.averageAge\n\nif(avgAge<=40){\n  reviewRequired=false\n}else{\n    reviewRequired=true\n}\n\nreturn[\n  {\njson:{\n      ...getAll[0].json,\n\nreviewRequired: reviewRequired\n\n\n  \n}\n\n\n\n    \n  }\n\n\n  \n]\n"
